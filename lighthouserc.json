{
  "ci": {
    "collect": {
      "startServerCommand": "node e2e/server.mjs",
      "startServerReadyPattern": "e2e stub server listening",
      "url": ["http://127.0.0.1:3080/login"],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.3 }],
        "categories:best-practices": ["warn", { "minScore": 0.5 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./e2e/lighthouse-report"
    }
  }
}
